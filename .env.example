# Vorlage für deine persönlichen API-Schlüssel.
# 1. Kopiere diese Datei und nenne die Kopie ".env"
# 2. Trage deine Schlüssel ein (ohne Anführungszeichen)
# Die Datei .env wird von Git ignoriert und landet nie auf GitHub.

# https://fred.stlouisfed.org/docs/api/api_key.html (optional, prices.py geht auch ohne)
FRED_API_KEY=

# https://www.eia.gov/opendata/register.php (optional, für Lagerbestände)
EIA_API_KEY=

# https://open-platform.theguardian.com/access/ (nötig für news_guardian.py)
GUARDIAN_API_KEY=
